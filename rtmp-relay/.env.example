# Copy this file to .env and fill in your values.

# ── Push destinations (bootstrap fallback) ──────────────────────────────
# These are used at container boot and any time the destination-watcher
# can't reach Supabase. Once you set the same fields in /admin, Supabase
# becomes the source of truth and the watcher reloads nginx within ~15s.

# YouTube — Stream Key from YouTube Studio > Go Live > Stream
DEST1=rtmp://a.rtmp.youtube.com/live2/YOUR_YOUTUBE_STREAM_KEY

# GameChanger — RTMP URL + key from the GC app under Streaming.
# This is per-game and rotates every game.
DEST2=rtmp://YOUR_GAMECHANGER_HOST/live/YOUR_GAMECHANGER_STREAM_KEY

# ── Supabase ────────────────────────────────────────────────────────────
# Used by stats-pusher (writes /stat XML → rtmp_stats table) and
# destination-watcher (reads outbound destinations from `settings` table).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_ANON_OR_SERVICE_ROLE_KEY

# ── Stream-down alerts (optional) ───────────────────────────────────────
# When NTFY_TOPIC is set, stats-pusher sends a push notification via
# https://ntfy.sh whenever a destination drops for more than
# ALERT_DELAY_SEC, and again when it recovers.
#
# Setup:
#   1. Install the ntfy app on your phone (iOS / Android, free).
#   2. Subscribe to a topic name only you know — e.g.
#      "hawks-stream-jx7q9kp" (anything random + unguessable).
#   3. Paste the same topic name below.
# The topic name IS the auth — anyone who guesses it can send you spam
# notifications, so don't share it publicly.
NTFY_TOPIC=
# Number of push destinations expected when streaming (YouTube + GameChanger = 2).
EXPECTED_PUSH_COUNT=2
# Seconds the stream must stay degraded before firing an alert (covers reconnects).
ALERT_DELAY_SEC=30
# URL opened when the operator taps the notification.
RELAY_LINK=https://streamthehawks.ca/relay
